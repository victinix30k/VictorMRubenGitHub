<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.iescanarias.vm.guardarrectangulo.guardarrectangulo.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Gestión de Rectángulo" />

    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Label text="Base:" />
            <TextField fx:id="txtBase" promptText="Ej: 12.0" prefWidth="80.0" />
            <Label text="Altura:" />
            <TextField fx:id="txtAltura" promptText="Ej: 13.0" prefWidth="80.0" />
        </children>
    </HBox>

    <HBox alignment="CENTER" spacing="15.0">
        <children>
            <Button fx:id="btnGuardar" onAction="#onGuardarClick" text="Guardar" />
            <Button fx:id="btnLeer" onAction="#onLeerClick" text="Leer" />
        </children>
    </HBox>

    <Label fx:id="lblResultado" text="Introduce valores o lee un archivo." wrapText="true" />
</VBox>